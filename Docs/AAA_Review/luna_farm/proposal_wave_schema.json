{
  "type": "object",
  "additionalProperties": false,
  "required": ["proposals"],
  "properties": {
    "proposals": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "pillar", "title", "change", "stage_targets", "placement",
          "assets", "implementation_notes", "expected_metric_effect",
          "capture_safe_reason", "acceptance_test", "effort", "priority_guess", "risk"
        ],
        "properties": {
          "id": { "type": "string" },
          "pillar": { "type": "string", "enum": ["materials", "aircraft", "city_ocean", "weapon_ads", "vfx"] },
          "title": { "type": "string" },
          "change": { "type": "string" },
          "stage_targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["Prop","PropHub","PropNose","YakBeauty","Cockpit","ADS","City","Combat","Harbor","Ocean","Wide"]
            }
          },
          "placement": { "type": "string", "enum": ["behind_wall", "additive_emissive", "unlit_hf_only"] },
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "required": ["meshes", "materials", "textures", "niagara"],
            "properties": {
              "meshes": { "type": "array", "items": { "type": "string" } },
              "materials": { "type": "array", "items": { "type": "string" } },
              "textures": { "type": "array", "items": { "type": "string" } },
              "niagara": { "type": "array", "items": { "type": "string" } }
            }
          },
          "implementation_notes": { "type": "string" },
          "expected_metric_effect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uniq_delta", "edge_delta", "black_delta", "cameras_helped", "cameras_risk"],
            "properties": {
              "uniq_delta": { "type": "string", "enum": ["up", "flat", "down"] },
              "edge_delta": { "type": "string", "enum": ["up", "flat", "down"] },
              "black_delta": { "type": "string", "enum": ["up", "flat", "down"] },
              "cameras_helped": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["Prop","PropHub","PropNose","YakBeauty","Cockpit","ADS","City","Combat","Harbor","Ocean","Wide"]
                }
              },
              "cameras_risk": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["Prop","PropHub","PropNose","YakBeauty","Cockpit","ADS","City","Combat","Harbor","Ocean","Wide"]
                }
              }
            }
          },
          "capture_safe_reason": { "type": "string" },
          "acceptance_test": { "type": "string" },
          "effort": { "type": "string", "enum": ["S", "M", "L"] },
          "priority_guess": { "type": "integer", "minimum": 1, "maximum": 20 },
          "risk": { "type": "string", "enum": ["low", "med", "high"] }
        }
      }
    }
  }
}
