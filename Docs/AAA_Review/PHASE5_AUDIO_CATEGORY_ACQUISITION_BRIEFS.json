{
  "schema": "skyguard.phase5.audio-category-briefs.v1",
  "authoritative_category_count": 25,
  "global_delivery": {
    "unreal_delivery_format": "WAV PCM, 48 kHz, 24-bit",
    "source_preference": "Project-owned 96 kHz/24-bit recordings or clearly licensed lossless originals",
    "raw_capture_headroom": "At least 12 dB below clipping with no AGC, limiting, normalization, denoising, or lossy codec",
    "derivative_policy": "Preserve immutable original and SHA-256; document and hash every edit/master derivative",
    "shipping_policy": "Cook derivatives only; exclude raw source archives and procedural QA audition signals"
  },
  "technical_profiles": {
    "AIRCRAFT_LOOP": {
      "capture_or_library_spec": "Stable engine/propeller beds at documented RPM and load, minimum 60 seconds per state plus 10-second transition handles; phase-coherent microphones; no other aircraft or speech.",
      "channel_requirement": "Mono close/airframe layer plus stereo or binaural rear-cockpit perspective where available",
      "loop_requirement": "Two independently reviewed seamless loop regions with no RPM drift, clicks, combing, or phase discontinuity"
    },
    "AIRFLOW_LOOP": {
      "capture_or_library_spec": "Rear-cockpit airflow at documented safe airspeeds and canopy openings, minimum 60 seconds per state; no speech or engine overload.",
      "channel_requirement": "Stereo/binaural cockpit perspective plus optional mono turbulence layer",
      "loop_requirement": "Seamless, non-pulsing beds that interpolate without obvious phasing"
    },
    "WEAPON_TRANSIENT": {
      "capture_or_library_spec": "Professionally licensed, safety-compliant source matching the final rifle; separate close transient and environmental tail where legally available.",
      "channel_requirement": "Mono close transient; stereo reflection/tail",
      "loop_requirement": "Not applicable; at least six usable variations for high-frequency events"
    },
    "WEAPON_MECHANICAL": {
      "capture_or_library_spec": "Close, isolated action/casing operation matching the final rifle animation; no muzzle blast or unrelated handling.",
      "channel_requirement": "Mono close",
      "loop_requirement": "Not applicable; timing handles must support animation sync"
    },
    "MISSILE_EVENT": {
      "capture_or_library_spec": "Clearly licensed shoulder-launched missile or professionally designed equivalent matched by sound designer; reject orbital rockets and unrelated propulsion.",
      "channel_requirement": "Mono emitter for seeker/lock; mono close plus stereo tail/fly-by for launch and flight",
      "loop_requirement": "Search tone may loop; other events require multiple clean one-shot variations"
    },
    "DRONE_PROPULSION": {
      "capture_or_library_spec": "Piston-powered UAV source with documented propulsion and steady states; electric multirotors are unacceptable substitutes.",
      "channel_requirement": "Mono emitter loops plus stereo/binaural fly-by perspectives",
      "loop_requirement": "At least two seamless steady-state loops per class and directionally clean fly-bys"
    },
    "EXPLOSION_LAYER": {
      "capture_or_library_spec": "Licensed or project-owned isolated crack/body/debris/tail layers with documented perspective; no clipping or baked music.",
      "channel_requirement": "Mono crack/body emitter where appropriate; stereo debris and environmental tail",
      "loop_requirement": "Not applicable; at least four variations per frequently repeated layer"
    }
  },
  "rights_profiles": {
    "PROJECT_OWNED_RECORDING": {
      "requirements": [
        "Signed recordist work-for-hire or assignment",
        "Aircraft/operator/location releases where applicable",
        "Performer releases for any identifiable voice",
        "Commercial interactive-game modification, embedding, distribution, marketing, and archival rights",
        "No obligation to distribute raw sources"
      ]
    },
    "LICENSED_LIBRARY": {
      "requirements": [
        "Direct publisher/source page and immutable license evidence",
        "Commercial interactive-game use",
        "Modification and derivative creation",
        "Embedding and end-user distribution in cooked builds",
        "No conflicting attribution, share-alike, noncommercial, or raw redistribution terms",
        "Creator/publisher, license ID, source filename, source URL, and SHA-256 recorded"
      ]
    }
  },
